{
  "name": "xumuge-ai",
  "private": true,
  "version": "1.0.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-foucui-h.mjs && vite",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev-port.ps1",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test \"scripts/lib/*.test.mjs\" \"scripts/guard-role-pack-quality.test.mjs\"",
    "test:integration": "node scripts/run-integration-regression.mjs",
    "build": "vite build && node scripts/guard-release-dist.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:signing": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows-signing.ps1",
    "prepare:signing": "node scripts/prepare-windows-signing.mjs",
    "prepare:release-clean": "node scripts/prepare-release-clean.mjs",
    "guard:release-bundle": "node scripts/guard-release-bundle.mjs",
    "build:release": "node scripts/guard-release-bundle.mjs && node scripts/prepare-windows-signing.mjs && pnpm run build:role-pack:full && node scripts/prepare-release-clean.mjs && tauri build",
    "build:release:unsigned": "node scripts/build-release-unsigned.mjs",
    "build:release:oss-unsigned": "node scripts/build-release-oss-unsigned.mjs",
    "tauri:dev": "tauri dev --features native-tts,devtools",
    "setup:rg": "powershell -ExecutionPolicy Bypass -File scripts/fetch-rg.ps1",
    "setup:qa": "npx playwright install chromium",
    "pack:offline-voice": "node scripts/pack-offline-voice.mjs",
    "fetch:sherpa-native": "node scripts/fetch-sherpa-native-libs.mjs",
    "translate:agency": "node scripts/translate-agency-all-zh.mjs",
    "translate:agency:scrub": "node scripts/translate-agency-all-zh.mjs --scrub-only",
    "fix:agency-catalog": "node scripts/agency-catalog-fix-all.mjs",
    "export:role-md": "node scripts/export-catalog-to-md.mjs",
    "build:role-pack": "node scripts/build-role-pack.mjs",
    "build:role-pack:demo": "node scripts/build-role-pack.mjs --locale zh-CN-virmoor --demo --pack-id virmoor-roles-demo-zh-CN --content-version 2026.09.1 --slugs xu-vue-foucui-engineer,design-brand-guardian,product-manager,engineering-backend-architect,business-strategist --out resources/role-packs/demo.zh-CN.xupack",
    "build:role-pack:dev": "node scripts/build-role-pack.mjs --locale zh-CN-virmoor --all --demo --pack-id virmoor-roles-zh-CN --content-version dev --skip-quality-gate --out resources/role-packs/dev.full.zh-CN.xupack",
    "ensure:dev-role-pack": "node scripts/ensure-dev-role-pack.mjs",
    "prepare:role-packs-server": "node scripts/prepare-role-packs-server.mjs",
    "prepare:voice-packs-server": "node scripts/prepare-voice-packs-server.mjs",
    "prepare:packs-server": "pnpm run prepare:role-packs-server && pnpm run prepare:voice-packs-server",
    "build:role-packs": "node scripts/build-role-pack-skus.mjs --sku demo-zh-CN",
    "build:role-packs:commercial": "node scripts/build-role-pack-skus.mjs",
    "guard:no-production-data": "node scripts/guard-no-production-data.mjs --staged",
    "guard:role-pack-quality": "node scripts/guard-role-pack-quality.mjs",
    "build:role-pack:skus": "node scripts/build-role-pack-skus.mjs",
    "postinstall": "node scripts/patch-foucui-h.mjs",
    "build:role-pack:full": "node scripts/build-role-pack.mjs --locale zh-virmoon --all --demo --pack-id virmoor-roles-demo-zh-virmoon --content-version 2026.09.1 --skip-quality-gate --out resources/role-packs/full.zh-CN.xupack"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vueuse/core": "^14.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "foucui": "^2.3.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.10",
    "mermaid": "^11.17.2",
    "pinia": "^4.0.3",
    "tauri-plugin-screenshots-api": "^2.2.0",
    "three": "^0.185.1",
    "vue": "^3.5.41",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
