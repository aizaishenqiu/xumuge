# Virmoor Desktop — env example (open-source)
# Copy to `.env.development` / `.env.production` locally. Do NOT commit real secrets.
# Placeholder domains use xxx.com — replace with your own API / site.
# Only VITE_* is bundled into the frontend; XU_* is for Tauri/Rust.

# ---------- Frontend (Vite) ----------
VITE_APP_ENV=development

# Store page (placeholder) + installer direct link (Gitee OSS release)
VITE_XU_STORE_URL=https://xxx.com/download
VITE_XU_DOWNLOAD_PAGE_URL=https://gitee.com/jiukakeji/xumuge/releases/download/%E8%99%9A%E5%8B%9F%E9%98%81%E4%B8%80%E4%BA%BAAI%E5%85%AC%E5%8F%B8%E6%A1%8C%E9%9D%A2%E7%AB%AF/%E8%99%9A%E5%8B%9F%E9%98%81_1.0.2_x64-setup.exe
VITE_XU_DESKTOP_UPDATE_SLUG=virmoor-desktop-windows

# Showcase site (optional)
# VITE_XU_SHOWCASE_URL=http://127.0.0.1:5340

# Account / license API (placeholders; local example commented)
# VITE_XU_ACCOUNT_URL=http://127.0.0.1:8080/api/v1
# VITE_XU_LICENSE_URL=http://127.0.0.1:8080/api/v1
# VITE_XU_ACCOUNT_URL=https://api.xxx.com/api/v1
# VITE_XU_LICENSE_URL=https://api.xxx.com/api/v1

VITE_XU_VOICE_PACK_CATALOG_URL=https://api.xxx.com/uploads/voice-packs/catalog.json
VITE_XU_VOICE_PACK_SITE_URL=https://api.xxx.com/uploads/voice-packs/catalog.json
# VITE_XU_VOICE_PACK_URLS=https://xxx.com/demo-sherpa.zip

VITE_XU_COSY_FASTAPI_URL=http://127.0.0.1:50000
VITE_XU_LOCAL_BRAIN_URL=http://127.0.0.1:8787/v1

# VITE_XU_DEV_USER=admin
# VITE_XU_DEV_PASSWORD=
# VITE_DEV_SERVER_PORT=1420

# ---------- Tauri / Rust ----------
# XU_ACCOUNT_URL=http://127.0.0.1:8080/api/v1
# XU_LICENSE_URL=http://127.0.0.1:8080/api/v1

# Optional download mirrors — fill your own; do not commit production URLs
# XU_GH_PROXY_PREFIXES=https://xxx.com/
# XU_HF_MIRROR=https://xxx.com/
# XU_NATIVE_ASR_URL=https://xxx.com/models/asr.tar.bz2
# XU_NATIVE_TTS_ONNX_URL=https://xxx.com/models/tts.onnx
# XU_NATIVE_TTS_VOICES_URL=https://xxx.com/models/voices.bin
# XU_ESPEAK_MSI_URL=https://xxx.com/espeak-ng.msi
# XU_COSY_GIT_URL=https://xxx.com/CosyVoice.git
# XU_MINICONDA_URL=https://xxx.com/Miniconda3-latest-Windows-x86_64.exe
# XU_PIP_INDEX=https://xxx.com/pypi/simple/
# XU_ALLOW_OVERSEAS_HF=0
